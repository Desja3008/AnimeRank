:root{--bg:#09090f;--panel:#11121b;--panel2:#171824;--line:#272936;--text:#f7f7fb;--muted:#9699aa;--pink:#d946ef;--pink2:#8b5cf6;--shadow:0 20px 60px rgba(0,0,0,.35);--radius:20px}*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 20% 0%,rgba(139,92,246,.12),transparent 28%),radial-gradient(circle at 90% 20%,rgba(217,70,239,.09),transparent 30%),var(--bg);color:var(--text);font-family:Inter,system-ui,sans-serif;min-height:100vh}.bg-orb{position:fixed;filter:blur(80px);opacity:.18;pointer-events:none;z-index:-1}.orb-a{width:300px;height:300px;background:#8b5cf6;left:-100px;top:250px}.orb-b{width:300px;height:300px;background:#d946ef;right:-120px;bottom:50px}.topbar{height:72px;border-bottom:1px solid rgba(255,255,255,.06);backdrop-filter:blur(18px);background:rgba(9,9,15,.7);display:flex;align-items:center;padding:0 max(22px,calc((100vw - 1200px)/2));gap:32px;position:sticky;top:0;z-index:20}.brand{font-family:'Space Grotesk';font-size:22px;font-weight:700;display:flex;align-items:center;gap:10px;cursor:pointer}.brand-mark{width:34px;height:34px;border-radius:10px;background:linear-gradient(135deg,var(--pink2),var(--pink));display:grid;place-items:center;box-shadow:0 8px 25px rgba(217,70,239,.25)}.accent{color:#e879f9}.topbar nav{display:flex;gap:5px}.nav-btn{border:0;background:transparent;color:var(--muted);padding:9px 13px;border-radius:10px;cursor:pointer;font:inherit}.nav-btn.active,.nav-btn:hover{color:#fff;background:rgba(255,255,255,.06)}.user-menu{margin-left:auto;display:flex;gap:10px;align-items:center}.user-menu>span{font-size:12px;color:#c7c9d5;background:#151621;border:1px solid var(--line);padding:8px 11px;border-radius:999px}.avatar{border:0;width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,#a855f7,#ec4899);color:#fff;font-weight:800;cursor:pointer}.container{max-width:1200px;margin:0 auto;padding:48px 22px 80px}.hero{display:flex;justify-content:space-between;gap:30px;align-items:end;margin-bottom:30px}.eyebrow{color:#c084fc;text-transform:uppercase;letter-spacing:.14em;font-size:11px;font-weight:800}.hero h1{font-family:'Space Grotesk';font-size:clamp(34px,5vw,58px);line-height:1.02;margin:8px 0 12px;letter-spacing:-.04em}.hero p{color:var(--muted);max-width:640px;margin:0;line-height:1.6}.btn{border:1px solid var(--line);background:#151621;color:#fff;padding:12px 16px;border-radius:12px;font-weight:700;cursor:pointer;transition:.2s}.btn:hover{transform:translateY(-1px);border-color:#414356}.btn.primary{border:0;background:linear-gradient(135deg,var(--pink2),var(--pink));box-shadow:0 10px 30px rgba(217,70,239,.2)}.btn.ghost{background:transparent}.section-head{display:flex;align-items:center;justify-content:space-between;margin:35px 0 14px}.section-head h2{font-family:'Space Grotesk';margin:0;font-size:22px}.section-head small{color:var(--muted)}.tier{margin:12px 0;border:1px solid var(--line);border-radius:18px;background:rgba(17,18,27,.82);overflow:hidden;box-shadow:0 10px 35px rgba(0,0,0,.12)}.tier-head{display:flex;align-items:center;gap:12px;padding:14px 17px;border-bottom:1px solid var(--line);background:rgba(255,255,255,.018)}.tier-icon{font-size:22px}.tier-title{font-weight:800}.tier-count{margin-left:auto;color:var(--muted);font-size:12px}.anime-grid{padding:15px;display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:13px}.anime-card{min-width:0;background:#151621;border:1px solid #252735;border-radius:15px;overflow:hidden;cursor:pointer;transition:.22s;position:relative}.anime-card:hover{transform:translateY(-4px);border-color:#484b60;box-shadow:var(--shadow)}.cover{width:100%;aspect-ratio:2/3;object-fit:cover;background:#20212c}.card-body{padding:11px}.title{font-weight:700;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.score{font-size:12px;color:#c4c6d2;margin-top:5px}.rank-badge{position:absolute;top:8px;left:8px;background:rgba(8,8,12,.78);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.12);border-radius:999px;padding:5px 8px;font-size:11px;font-weight:800}.empty{padding:28px;color:var(--muted);text-align:center}.search-row{display:flex;gap:10px}.search{flex:1;background:#11121b;border:1px solid var(--line);color:#fff;border-radius:13px;padding:13px 14px;font:inherit;outline:none}.search:focus{border-color:#69507e}.stats-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.stat{padding:20px;border:1px solid var(--line);border-radius:18px;background:rgba(17,18,27,.8)}.stat b{font-size:30px;font-family:'Space Grotesk'}.stat span{display:block;color:var(--muted);font-size:12px;margin-top:5px}.modal-back{position:fixed;inset:0;background:rgba(0,0,0,.72);backdrop-filter:blur(8px);display:grid;place-items:center;padding:18px;z-index:50}.modal{width:min(760px,100%);max-height:90vh;overflow:auto;background:#11121b;border:1px solid #2a2c3a;border-radius:24px;box-shadow:0 30px 100px rgba(0,0,0,.55)}.modal-head{display:flex;align-items:center;justify-content:space-between;padding:18px 20px;border-bottom:1px solid var(--line)}.modal-head h3{margin:0;font-family:'Space Grotesk'}.close{background:transparent;border:0;color:#aaa;font-size:24px;cursor:pointer}.modal-body{padding:20px}.detail{display:grid;grid-template-columns:190px 1fr;gap:22px}.detail img{width:190px;border-radius:16px}.detail h2{font-family:'Space Grotesk';font-size:30px;margin:0 0 8px}.muted{color:var(--muted);line-height:1.55}.distribution{margin-top:22px}.dist-row{display:grid;grid-template-columns:120px 1fr 45px;gap:10px;align-items:center;margin:9px 0;font-size:12px}.bar{height:8px;border-radius:99px;background:#242633;overflow:hidden}.fill{height:100%;background:linear-gradient(90deg,var(--pink2),var(--pink));border-radius:99px}.vote-options{display:grid;grid-template-columns:repeat(2,1fr);gap:9px;margin-top:18px}.vote{padding:13px;border:1px solid var(--line);background:#151621;color:#fff;border-radius:12px;text-align:left;cursor:pointer}.vote:hover{border-color:#665075;background:#1a1b27}.vote.selected{border-color:#d946ef;background:rgba(217,70,239,.1)}.friends{margin-top:22px;border-top:1px solid var(--line);padding-top:18px}.friend{display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px solid rgba(255,255,255,.05);font-size:13px}.toast{position:fixed;right:20px;bottom:20px;background:#171824;border:1px solid #363849;padding:13px 16px;border-radius:12px;box-shadow:var(--shadow);transform:translateY(20px);opacity:0;pointer-events:none;transition:.25s;z-index:100;font-size:13px}.toast.show{transform:none;opacity:1}.search-results{display:grid;grid-template-columns:repeat(auto-fill,minmax(145px,1fr));gap:12px;margin-top:15px}.result{border:1px solid var(--line);background:#151621;border-radius:14px;overflow:hidden;cursor:pointer}.result img{width:100%;aspect-ratio:2/3;object-fit:cover}.result div{padding:9px;font-size:12px;font-weight:700}.pill{display:inline-block;padding:5px 8px;border-radius:999px;background:#1d1e2a;color:#c9cbd5;font-size:11px}.profile{display:grid;gap:12px}.input{background:#0c0d14;border:1px solid var(--line);color:#fff;padding:12px;border-radius:11px;width:100%;font:inherit}.profile-row{display:flex;gap:10px}.notice{padding:12px 14px;border:1px solid #3a2e43;background:rgba(139,92,246,.07);border-radius:12px;color:#c9c5d3;font-size:12px;line-height:1.5}@media(max-width:720px){.topbar{padding:0 14px}.topbar nav{display:none}.user-menu>span{display:none}.container{padding-top:30px}.hero{display:block}.hero .btn{margin-top:20px;width:100%}.stats-grid{grid-template-columns:1fr}.detail{grid-template-columns:110px 1fr}.detail img{width:110px}.detail h2{font-size:22px}.anime-grid{grid-template-columns:repeat(2,1fr)}.vote-options{grid-template-columns:1fr}.dist-row{grid-template-columns:90px 1fr 35px}}
.hero-meta{display:flex;flex-wrap:wrap;gap:8px;margin-top:18px}.hero-meta span{font-size:12px;color:#c5c7d2;border:1px solid var(--line);background:rgba(255,255,255,.035);padding:7px 10px;border-radius:999px}.hero-btn{white-space:nowrap}.head-actions{display:flex;gap:8px}.page-title-row{display:flex;justify-content:space-between;align-items:end;margin:8px 0 25px}.page-title-row h1{font-family:'Space Grotesk';font-size:44px;margin:0}.page-title-row p{margin:8px 0 0}.stats-grid{grid-template-columns:repeat(4,1fr)!important}.stat{min-height:145px;display:flex;flex-direction:column;justify-content:center}.stat span{font-size:12px;color:var(--muted);order:0}.stat b{font-size:36px;margin:8px 0 3px}.stat small{color:#c2c4cf}.analytics{margin-top:20px;padding:20px;border:1px solid var(--line);border-radius:18px;background:rgba(17,18,27,.82)}.analytics .section-head{margin:0 0 18px}.top-list{display:grid;gap:8px}.top-item{display:grid;grid-template-columns:32px 42px 1fr auto;gap:12px;align-items:center;width:100%;border:1px solid transparent;background:#151621;color:#fff;border-radius:12px;padding:8px;text-align:left;cursor:pointer}.top-item:hover{border-color:#414356}.top-item img{width:42px;height:52px;object-fit:cover;border-radius:7px}.top-item strong{font-size:13px}.top-item em{font-style:normal;color:#cfd0da;font-weight:700}.loading{padding:24px;text-align:center;color:var(--muted)}.search-results{grid-template-columns:repeat(4,minmax(0,1fr))}.result{padding:0;color:#fff;text-align:left}.result div{display:flex;flex-direction:column;gap:3px}.result small{color:var(--muted);font-weight:500}.vote-intro{display:flex;gap:15px;align-items:center}.vote-intro img{width:72px;height:100px;object-fit:cover;border-radius:10px}.vote-intro h2{font-family:'Space Grotesk';margin:4px 0}.vote-options{grid-template-columns:repeat(3,1fr)}.vote{display:grid;grid-template-columns:auto 1fr;gap:2px 9px;align-items:center}.vote span{font-size:23px;grid-row:1/3}.vote b{font-size:13px}.vote small{color:var(--muted)}.vote.unseen{display:flex;align-items:center;gap:10px;width:100%;margin-top:9px}.vote.unseen small{margin-left:auto}.big-score{font-size:30px;font-weight:800;margin:10px 0}.big-score span{font-size:13px;color:var(--muted)}.member-preview{display:flex;align-items:center;margin:2px 0 8px}.member-preview span{width:32px;height:32px;border-radius:50%;background:#252735;display:grid;place-items:center;margin-right:-5px;border:2px solid #11121b}.member-preview b{font-size:12px;color:var(--muted);margin-left:12px}.setting{display:flex;justify-content:space-between;gap:15px;align-items:center;padding:14px 0;border-bottom:1px solid var(--line)}.setting span{display:block;color:var(--muted);font-size:12px;margin-top:4px}.empty-tier{opacity:.8}.ranking-board{display:grid;gap:10px}
@media(max-width:900px){.stats-grid{grid-template-columns:repeat(2,1fr)!important}.search-results{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:720px){.page-title-row{display:block}.page-title-row .btn{margin-top:15px;width:100%}.head-actions .btn{padding:10px 12px}.stats-grid{grid-template-columns:1fr!important}.search-results{grid-template-columns:repeat(2,minmax(0,1fr))}.vote-options{grid-template-columns:1fr}.vote-intro{align-items:flex-start}.top-item{grid-template-columns:28px 42px 1fr}.top-item em{grid-column:3}.vote.unseen small{display:none}}
